# Copy to .env and fill locally. Never commit .env.

# Local data roots on the workstation
CPOMP_DATA_RAW=./data/raw
CPOMP_DATA_PROCESSED=./data/processed
CPOMP_DATA_EXTERNAL=./data/external

# Optional public-resource caches (directories you create)
OPENPEDCAN_DIR=
TARGET_DIR=
PEDCBIO_CACHE=

# Optional compute
CPOMP_THREADS=8
